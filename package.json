{
  "name": "@xiaopb/dsh-mobile-layout",
  "version": "0.4.12",
  "description": "DSH web-UI plugin: phone-portrait layout shell. Keeps the official AppFrame untouched on desktop, and on phone portrait switches the sidebar to an off-canvas drawer, adds a 56px persistent action bar under the composer (new / sessions / files / images / plugins / more), keeps permission and model controls in the composer row, and folds the header tools into a compact corner. All overrides are scoped to html[data-dshm-mode=\"mobile\"] and fall back to the official layout when anchors are missing.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "styles",
    "contracts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/client.js && npm test && node scripts/verify-package.mjs && node scripts/check-hardcoded.mjs && node scripts/check-tokens.mjs && node scripts/check-colors.mjs && node scripts/check-contracts.mjs && node scripts/check-compat.mjs && node scripts/check-important.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "metrics": "node scripts/metrics.mjs",
    "hardcode:check": "node scripts/check-hardcoded.mjs",
    "hardcode:baseline": "node scripts/check-hardcoded.mjs --update",
    "pack:dry": "npm pack --dry-run",
    "prepack": "node scripts/verify-package.mjs",
    "colors:check": "node scripts/check-colors.mjs",
    "colors:baseline": "node scripts/check-colors.mjs --update",
    "contracts:check": "node scripts/check-contracts.mjs",
    "compat:check": "node scripts/check-compat.mjs",
    "contract:drift": "node scripts/contract-snapshot.mjs",
    "important:check": "node scripts/check-important.mjs",
    "important:baseline": "node scripts/check-important.mjs --update"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      },
      "capabilities": {
        "slots": [
          "shell.overlay",
          "shell.bottom",
          "conversation.input.left",
          "settings.general.item"
        ],
        "services": [
          "slots",
          "layout",
          "locale",
          "sessions",
          "uiWorkspace",
          "sidebarRight"
        ],
        "dialogContract": "data-shortcut-modal"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoPb/dsh-mobile-layout.git"
  },
  "homepage": "https://github.com/XiaoPb/dsh-mobile-layout#readme",
  "bugs": {
    "url": "https://github.com/XiaoPb/dsh-mobile-layout/issues"
  },
  "author": "XiaoPb",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "layout",
    "mobile",
    "android",
    "drawer",
    "phone"
  ]
}
